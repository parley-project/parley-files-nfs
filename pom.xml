<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- License, developer, SCM, URL, Java level and the Maven Central release profile
	     all come from parley-parent. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>2.0.0-SNAPSHOT</version>
		<relativePath>../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-files-nfs</artifactId>
	<name>Parley Files NFS</name>
	<description>A parley-files FileSource implementation for NFSv4 servers (RFC 7530), built on the
		parley-nfs client and found at runtime through ServiceLoader: nfs://host[:port]/path. Logs in with
		AUTH_SYS or Kerberos (krb5, krb5i, krb5p) and has random access, seekable streams, permissions,
		owner and group, times, symbolic links and byte-range locks that other NFS clients see.</description>

	<properties>
		<!-- Written to the jar manifest as Automatic-Module-Name -->
		<parley.moduleName>us.bringardner.parley.files.nfs</parley.moduleName>
	</properties>

	<!-- GitHub Packages. Maven Central releases use: mvn -Prelease clean deploy -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>parley-project</name>
			<url>https://maven.pkg.github.com/parley-project/parley-files-nfs</url>
		</repository>
	</distributionManagement>

	<build>
		<plugins>
			<!-- Attaches the -sources.jar. The version comes from parley-parent; package (not deploy)
			     so the source jar is attached BEFORE the deploy plugin runs. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-sources</id>
						<phase>package</phase>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- The NFS client (NfsClient, NfsKerberos) and, for the tests, the server -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-nfs</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- parley-nfs's test classes: TestKdc, a Kerberos KDC for the Kerberos tests -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-nfs</artifactId>
			<version>${project.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<!-- Kerby, which TestKdc uses (test scope dependencies aren't passed on) -->
		<dependency>
			<groupId>org.apache.kerby</groupId>
			<artifactId>kerb-simplekdc</artifactId>
			<version>2.0.3</version>
			<scope>test</scope>
		</dependency>

		<!-- The shared parley-files test suite -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files</artifactId>
			<version>${project.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<!-- Tests log through parley-logging's ParleyLogger (an application's choice, so only for the tests) -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-logging</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<!-- The helpers that set a level, collect log lines and keep expected errors out of the output -->
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-logging</artifactId>
			<version>${project.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.13.4</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
